{
  "description": "Moonraker WebSocket message examples for all message types",
  "websocket_messages": {
    "connection_established": {
      "description": "Initial connection acknowledgment",
      "message": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "websocket_id": 12345,
          "klippy_connected": true,
          "klippy_state": "ready"
        }
      }
    },
    "subscription_request": {
      "description": "Subscribe to printer object updates",
      "message": {
        "jsonrpc": "2.0",
        "method": "printer.objects.subscribe",
        "params": {
          "objects": {
            "print_stats": ["state", "filename", "print_duration"],
            "display_status": ["progress", "message"],
            "extruder": ["temperature", "target"],
            "heater_bed": ["temperature", "target"],
            "toolhead": ["position", "homed_axes"],
            "pause_resume": ["is_paused"]
          }
        },
        "id": 2
      }
    },
    "subscription_response": {
      "description": "Response to subscription request with current values",
      "message": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "status": {
            "print_stats": {
              "state": "standby",
              "filename": "",
              "print_duration": 0.0
            },
            "display_status": {
              "progress": 0.0,
              "message": "Printer is ready"
            },
            "extruder": {
              "temperature": 22.5,
              "target": 0.0
            },
            "heater_bed": {
              "temperature": 21.8,
              "target": 0.0
            },
            "toolhead": {
              "position": [0.0, 0.0, 0.0, 0.0],
              "homed_axes": ""
            },
            "pause_resume": {
              "is_paused": false
            }
          }
        }
      }
    },
    "status_update": {
      "description": "Regular status updates when subscribed objects change",
      "examples": [
        {
          "description": "Temperature update during heating",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_status_update",
            "params": [
              {
                "extruder": {
                  "temperature": 185.2,
                  "target": 210.0,
                  "power": 0.9
                },
                "heater_bed": {
                  "temperature": 55.1,
                  "target": 60.0,
                  "power": 0.4
                }
              },
              1634567890.123
            ]
          }
        },
        {
          "description": "Print progress update",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_status_update",
            "params": [
              {
                "print_stats": {
                  "print_duration": 1456.78,
                  "filename": "test_print.gcode"
                },
                "display_status": {
                  "progress": 0.67,
                  "message": "Printing layer 100/150"
                },
                "virtual_sdcard": {
                  "progress": 0.67,
                  "file_position": 184320
                }
              },
              1634567895.456
            ]
          }
        },
        {
          "description": "Toolhead position update during print",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_status_update",
            "params": [
              {
                "toolhead": {
                  "position": [145.5, 123.8, 35.2, 245.7],
                  "print_time": 1456.78
                },
                "gcode_move": {
                  "position": [145.5, 123.8, 35.2, 245.7],
                  "speed_factor": 1.0,
                  "extrude_factor": 1.0
                }
              },
              1634567896.789
            ]
          }
        }
      ]
    },
    "print_state_changes": {
      "description": "Print state transition notifications",
      "examples": [
        {
          "description": "Print started",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_status_update",
            "params": [
              {
                "print_stats": {
                  "state": "printing",
                  "filename": "calibration_cube.gcode",
                  "print_duration": 0.0
                },
                "display_status": {
                  "progress": 0.0,
                  "message": "Started printing calibration_cube.gcode"
                }
              },
              1634567900.123
            ]
          }
        },
        {
          "description": "Print paused",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_status_update",
            "params": [
              {
                "print_stats": {
                  "state": "paused"
                },
                "pause_resume": {
                  "is_paused": true
                },
                "display_status": {
                  "message": "Print paused by user"
                }
              },
              1634568500.456
            ]
          }
        },
        {
          "description": "Print completed",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_status_update",
            "params": [
              {
                "print_stats": {
                  "state": "complete",
                  "total_duration": 2847.92,
                  "print_duration": 2847.92,
                  "filament_used": 1250.5
                },
                "display_status": {
                  "progress": 1.0,
                  "message": "Print completed successfully"
                }
              },
              1634570747.915
            ]
          }
        }
      ]
    },
    "error_notifications": {
      "description": "Error condition notifications",
      "examples": [
        {
          "description": "Emergency stop triggered",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_klippy_shutdown",
            "params": []
          }
        },
        {
          "description": "Printer error state",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_status_update",
            "params": [
              {
                "print_stats": {
                  "state": "error",
                  "message": "Thermal runaway detected on extruder"
                }
              },
              1634567950.789
            ]
          }
        },
        {
          "description": "Connection lost to Klipper",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_klippy_disconnected",
            "params": []
          }
        }
      ]
    },
    "gcode_response": {
      "description": "G-code command responses",
      "examples": [
        {
          "description": "G-code command acknowledgment",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_gcode_response",
            "params": ["ok"]
          }
        },
        {
          "description": "G-code command with output",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_gcode_response", 
            "params": ["// Current position: X:135.0 Y:135.0 Z:25.5 E:150.2"]
          }
        },
        {
          "description": "G-code error response",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_gcode_response",
            "params": ["!! Unknown command: \"G999\""]
          }
        }
      ]
    },
    "file_manager_notifications": {
      "description": "File system change notifications",
      "examples": [
        {
          "description": "File uploaded",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_filelist_changed",
            "params": [
              {
                "action": "create_file",
                "item": {
                  "path": "gcodes/new_print.gcode",
                  "root": "gcodes",
                  "size": 1024576,
                  "modified": 1634567890.123
                }
              }
            ]
          }
        },
        {
          "description": "File deleted",
          "message": {
            "jsonrpc": "2.0",
            "method": "notify_filelist_changed",
            "params": [
              {
                "action": "delete_file",
                "item": {
                  "path": "gcodes/old_print.gcode",
                  "root": "gcodes"
                }
              }
            ]
          }
        }
      ]
    },
    "heartbeat": {
      "description": "Regular heartbeat to maintain connection",
      "message": {
        "jsonrpc": "2.0",
        "method": "notify_status_update",
        "params": [
          {},
          1634567890.123
        ]
      }
    }
  },
  "client_messages": {
    "description": "Messages that clients send to Moonraker",
    "emergency_stop": {
      "description": "Trigger emergency stop",
      "message": {
        "jsonrpc": "2.0",
        "method": "printer.emergency_stop",
        "id": 123
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 123,
        "result": "ok"
      }
    },
    "gcode_script": {
      "description": "Execute G-code command",
      "message": {
        "jsonrpc": "2.0",
        "method": "printer.gcode.script",
        "params": {
          "script": "G28 ; Home all axes"
        },
        "id": 124
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 124,
        "result": "ok"
      }
    },
    "object_query": {
      "description": "Query specific printer objects",
      "message": {
        "jsonrpc": "2.0",
        "method": "printer.objects.query",
        "params": {
          "objects": {
            "extruder": null,
            "heater_bed": null,
            "print_stats": null
          }
        },
        "id": 125
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 125,
        "result": {
          "status": {
            "extruder": {
              "temperature": 205.2,
              "target": 210.0,
              "power": 0.8
            },
            "heater_bed": {
              "temperature": 58.9,
              "target": 60.0,
              "power": 0.25
            },
            "print_stats": {
              "state": "printing",
              "filename": "test_print.gcode",
              "print_duration": 1234.56
            }
          }
        }
      }
    }
  }
}