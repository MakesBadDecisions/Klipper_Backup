{
  "description": "Complete Moonraker REST API endpoint reference for Printer Buddy development",
  "base_url": "http://printer-ip:7125",
  "api_endpoints": {
    "server_info": {
      "method": "GET",
      "path": "/server/info",
      "description": "Get server and Klippy information",
      "parameters": {},
      "response_example": {
        "result": {
          "klippy_connected": true,
          "klippy_state": "ready",
          "components": ["klippy_apis", "file_manager", "database"],
          "failed_components": [],
          "registered_directories": {
            "gcodes": "/home/pi/printer_data/gcodes",
            "config": "/home/pi/printer_data/config"
          },
          "warnings": [],
          "websocket_count": 2,
          "moonraker_version": "v0.8.0-123-g1a2b3c4"
        }
      }
    },
    "printer_info": {
      "method": "GET", 
      "path": "/printer/info",
      "description": "Get printer status and information",
      "parameters": {},
      "response_example": {
        "result": {
          "state": "ready",
          "state_message": "Printer is ready",
          "hostname": "qidi-printer",
          "software_version": "v0.11.0-293-g1a2b3c4",
          "cpu_info": "4 core ARMv7 Processor",
          "klipper_path": "/home/pi/klipper",
          "python_path": "/home/pi/klippy-env/bin/python",
          "log_file": "/tmp/klippy.log",
          "config_file": "/home/pi/printer_data/config/printer.cfg"
        }
      }
    },
    "emergency_stop": {
      "method": "POST",
      "path": "/printer/emergency_stop",
      "description": "Trigger emergency stop - halts all operations immediately",
      "parameters": {},
      "response_example": {
        "result": "ok"
      },
      "error_example": {
        "error": {
          "code": 400,
          "message": "Klippy not connected"
        }
      }
    },
    "firmware_restart": {
      "method": "POST",
      "path": "/printer/firmware_restart",
      "description": "Restart Klipper firmware",
      "parameters": {},
      "response_example": {
        "result": "ok"
      }
    },
    "restart": {
      "method": "POST", 
      "path": "/printer/restart",
      "description": "Restart Klipper host software",
      "parameters": {},
      "response_example": {
        "result": "ok"
      }
    },
    "objects_list": {
      "method": "GET",
      "path": "/printer/objects/list",
      "description": "List all available printer objects",
      "parameters": {},
      "response_example": {
        "result": {
          "objects": [
            "webhooks",
            "configfile", 
            "mcu",
            "gcode_move",
            "print_stats",
            "virtual_sdcard",
            "pause_resume", 
            "display_status",
            "gcode",
            "toolhead",
            "extruder",
            "heater_bed",
            "fan"
          ]
        }
      }
    },
    "objects_query": {
      "method": "GET",
      "path": "/printer/objects/query",
      "description": "Query specific printer objects and their current values",
      "parameters": {
        "objects": "Comma-separated list of objects to query (optional - if not provided, returns all)",
        "extruder": "Include extruder object",
        "heater_bed": "Include heater_bed object", 
        "print_stats": "Include print_stats object",
        "toolhead": "Include toolhead object"
      },
      "example_url": "/printer/objects/query?extruder&heater_bed&print_stats&toolhead",
      "response_example": {
        "result": {
          "status": {
            "extruder": {
              "temperature": 205.2,
              "target": 210.0,
              "power": 0.8,
              "can_extrude": true,
              "pressure_advance": 0.05,
              "smooth_time": 0.04
            },
            "heater_bed": {
              "temperature": 58.9,
              "target": 60.0,
              "power": 0.25
            },
            "print_stats": {
              "filename": "test_print.gcode",
              "total_duration": 0.0,
              "print_duration": 1234.56,
              "filament_used": 1250.5,
              "state": "printing",
              "message": "Printing test_print.gcode"
            },
            "toolhead": {
              "homed_axes": "xyz",
              "position": [135.0, 135.0, 25.5, 150.2],
              "print_time": 1234.56,
              "estimated_print_time": 2468.0,
              "max_velocity": 200.0,
              "max_accel": 3000.0
            }
          },
          "eventtime": 1634567890.123
        }
      }
    },
    "gcode_script": {
      "method": "POST",
      "path": "/printer/gcode/script",
      "description": "Execute G-code commands",
      "parameters": {
        "script": "G-code command(s) to execute"
      },
      "request_example": {
        "script": "G28 ; Home all axes"
      },
      "response_example": {
        "result": "ok"
      },
      "common_commands": [
        "G28 ; Home all axes",
        "G28 X Y ; Home X and Y axes",
        "G1 X100 Y100 F3000 ; Move to X100 Y100",
        "M104 S210 ; Set extruder temperature",
        "M140 S60 ; Set bed temperature",
        "M109 S210 ; Wait for extruder temperature",
        "M190 S60 ; Wait for bed temperature",
        "M106 S255 ; Turn on part cooling fan full speed",
        "M107 ; Turn off part cooling fan"
      ]
    },
    "gcode_help": {
      "method": "GET",
      "path": "/printer/gcode/help",
      "description": "Get available G-code commands and their descriptions",
      "parameters": {},
      "response_example": {
        "result": {
          "HELP": "Display this help message",
          "G28": "Home the axes",
          "G1": "Linear move",
          "M104": "Set extruder temperature",
          "M140": "Set bed temperature"
        }
      }
    },
    "print_start": {
      "method": "POST",
      "path": "/printer/print/start",
      "description": "Start printing a file",
      "parameters": {
        "filename": "Name of file to print (in gcodes directory)"
      },
      "request_example": {
        "filename": "test_print.gcode"
      },
      "response_example": {
        "result": "ok"
      }
    },
    "print_pause": {
      "method": "POST",
      "path": "/printer/print/pause",
      "description": "Pause current print job",
      "parameters": {},
      "response_example": {
        "result": "ok"
      }
    },
    "print_resume": {
      "method": "POST",
      "path": "/printer/print/resume",
      "description": "Resume paused print job",
      "parameters": {},
      "response_example": {
        "result": "ok"
      }
    },
    "print_cancel": {
      "method": "POST",
      "path": "/printer/print/cancel",
      "description": "Cancel current print job",
      "parameters": {},
      "response_example": {
        "result": "ok"
      }
    },
    "files_list": {
      "method": "GET",
      "path": "/server/files/list",
      "description": "List files in specified directory",
      "parameters": {
        "root": "Root directory (gcodes, config, etc.)"
      },
      "example_url": "/server/files/list?root=gcodes",
      "response_example": {
        "result": [
          {
            "path": "test_print.gcode",
            "modified": 1634567890.123,
            "size": 1024576,
            "permissions": "rw"
          },
          {
            "path": "calibration_cube.gcode", 
            "modified": 1634567800.456,
            "size": 2048000,
            "permissions": "rw"
          }
        ]
      }
    },
    "file_metadata": {
      "method": "GET",
      "path": "/server/files/metadata",
      "description": "Get metadata for a specific G-code file",
      "parameters": {
        "filename": "Name of G-code file"
      },  
      "example_url": "/server/files/metadata?filename=test_print.gcode",
      "response_example": {
        "result": {
          "print_start_time": null,
          "job_id": null,
          "size": 1024576,
          "modified": 1634567890.123,
          "slicer": "PrusaSlicer",
          "slicer_version": "2.4.0",
          "layer_height": 0.2,
          "first_layer_height": 0.3,
          "object_height": 20.0,
          "estimated_time": 2468,
          "nozzle_diameter": 0.4,
          "layer_count": 100,
          "filament_total": 1250.5,
          "thumbnails": [
            {
              "width": 32,
              "height": 32,
              "size": 1024,
              "relative_path": ".thumbs/test_print-32x32.png"
            }
          ]
        }
      }
    },
    "temperature_store": {
      "method": "GET", 
      "path": "/server/temperature_store",
      "description": "Get historical temperature data",
      "parameters": {
        "include_monitors": "Include temperature monitors (optional)"
      },
      "response_example": {
        "result": {
          "extruder": {
            "temperatures": [205.1, 205.2, 205.0, 205.3],
            "targets": [210.0, 210.0, 210.0, 210.0],
            "powers": [0.8, 0.8, 0.7, 0.9]
          },
          "heater_bed": {
            "temperatures": [58.8, 58.9, 59.0, 58.9], 
            "targets": [60.0, 60.0, 60.0, 60.0],
            "powers": [0.25, 0.25, 0.3, 0.25]
          }
        }
      }
    }
  },
  "error_responses": {
    "description": "Common error response formats",
    "klippy_not_connected": {
      "error": {
        "code": 503,
        "message": "Klippy not connected",
        "traceback": "ServiceUnavailable: Klippy not connected"
      }
    },
    "invalid_request": {
      "error": {
        "code": 400,
        "message": "Invalid request parameter",
        "traceback": "BadRequest: Invalid request parameter 'invalid_param'"
      }  
    },
    "printer_not_ready": {
      "error": {
        "code": 503,
        "message": "Printer is not ready",
        "traceback": "ServiceUnavailable: Printer is not ready"
      }
    },
    "file_not_found": {
      "error": {
        "code": 404,
        "message": "File not found: test_print.gcode",
        "traceback": "NotFound: File not found"
      }
    }
  },
  "websocket_info": {
    "description": "WebSocket connection information",
    "connection_url": "ws://printer-ip:7125/websocket",
    "protocols": ["moonraker"],
    "initial_connection": "Send printer.info request to establish connection",
    "subscriptions": "Use printer.objects.subscribe to get real-time updates",
    "heartbeat": "Server sends regular heartbeat messages to maintain connection"
  }
}