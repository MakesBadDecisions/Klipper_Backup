{
  "description": "Real Moonraker printer objects structure - use this as reference for mock data",
  "moonraker_version": "v0.8.0+",
  "printer_objects": {
    "print_stats": {
      "description": "Print job statistics and current state",
      "properties": {
        "filename": "string - Currently loaded file name",
        "total_duration": "float - Total print time in seconds", 
        "print_duration": "float - Current print time in seconds",
        "filament_used": "float - Filament used in mm",
        "state": "string - Current print state",
        "message": "string - Current status message",
        "info": {
          "total_layer": "int - Total layers in print",
          "current_layer": "int - Current layer number"
        }
      },
      "states": ["standby", "printing", "paused", "complete", "cancelled", "error"],
      "example": {
        "filename": "test_print.gcode",
        "total_duration": 0.0,
        "print_duration": 1234.56,
        "filament_used": 1250.5,
        "state": "printing",
        "message": "Printing test_print.gcode",
        "info": {
          "total_layer": 150,
          "current_layer": 75
        }
      }
    },
    "display_status": {
      "description": "Display status for UI updates",
      "properties": {
        "progress": "float - Print progress 0.0-1.0",
        "message": "string - Display message"
      },
      "example": {
        "progress": 0.45,
        "message": "Printing... 45% complete"
      }
    },
    "extruder": {
      "description": "Hotend extruder status",
      "properties": {
        "temperature": "float - Current temperature in Celsius",
        "target": "float - Target temperature in Celsius", 
        "power": "float - Heater power 0.0-1.0",
        "can_extrude": "bool - Whether extruder can extrude"
      },
      "example": {
        "temperature": 205.2,
        "target": 210.0,
        "power": 0.8,
        "can_extrude": true
      }
    },
    "heater_bed": {
      "description": "Heated bed status",
      "properties": {
        "temperature": "float - Current bed temperature",
        "target": "float - Target bed temperature",
        "power": "float - Bed heater power 0.0-1.0"
      },
      "example": {
        "temperature": 58.7,
        "target": 60.0,
        "power": 0.3
      }
    },
    "toolhead": {
      "description": "Toolhead position and movement status",
      "properties": {
        "homed_axes": "string - Which axes are homed (xyz)",
        "axis_minimum": "array - [x_min, y_min, z_min]",
        "axis_maximum": "array - [x_max, y_max, z_max]",
        "max_velocity": "float - Maximum velocity mm/s",
        "max_accel": "float - Maximum acceleration mm/s²",
        "position": "array - [x, y, z, e] current position",
        "print_time": "float - Total print time",
        "estimated_print_time": "float - Estimated total print time"
      },
      "example": {
        "homed_axes": "xyz",
        "axis_minimum": [0, 0, 0],
        "axis_maximum": [270, 270, 300],
        "max_velocity": 200.0,
        "max_accel": 3000.0,
        "position": [135.0, 135.0, 25.5, 150.2],
        "print_time": 1234.56,
        "estimated_print_time": 2468.0
      }
    },
    "gcode_move": {
      "description": "G-code movement coordinates",
      "properties": {
        "speed_factor": "float - Speed factor multiplier",
        "extrude_factor": "float - Extrusion factor multiplier",
        "absolute_coordinates": "bool - Using absolute coordinates",
        "absolute_extrude": "bool - Using absolute extrusion",
        "homing_origin": "array - [x, y, z, e] homing origin",
        "position": "array - [x, y, z, e] gcode position",
        "gcode_position": "array - [x, y, z, e] gcode coordinates"
      },
      "example": {
        "speed_factor": 1.0,
        "extrude_factor": 1.0,
        "absolute_coordinates": true,
        "absolute_extrude": true,
        "homing_origin": [0.0, 0.0, 0.0, 0.0],
        "position": [135.0, 135.0, 25.5, 150.2],
        "gcode_position": [135.0, 135.0, 25.5, 150.2]
      }
    },
    "virtual_sdcard": {
      "description": "Virtual SD card status for file printing",
      "properties": {
        "file_path": "string - Path to current file",
        "progress": "float - File read progress 0.0-1.0",
        "is_active": "bool - Whether virtual SD card is active",
        "file_position": "int - Current file position in bytes",
        "file_size": "int - Total file size in bytes"
      },
      "example": {
        "file_path": "/home/pi/printer_data/gcodes/test_print.gcode",
        "progress": 0.45,
        "is_active": true,
        "file_position": 123456,
        "file_size": 274680
      }
    },
    "pause_resume": {
      "description": "Pause and resume state",
      "properties": {
        "is_paused": "bool - Whether print is currently paused"
      },
      "example": {
        "is_paused": false
      }
    },
    "fan": {
      "description": "Part cooling fan status",
      "properties": {
        "speed": "float - Fan speed 0.0-1.0",
        "rpm": "int - Fan RPM if tachometer available"
      },
      "example": {
        "speed": 0.8,
        "rpm": 2400
      }
    },
    "temperature_host": {
      "description": "Host system temperature",
      "properties": {
        "temperature": "float - Host CPU temperature"
      },
      "example": {
        "temperature": 45.2
      }
    }
  },
  "websocket_object_format": {
    "description": "How objects are sent via WebSocket",
    "example_notification": {
      "jsonrpc": "2.0",
      "method": "notify_status_update",
      "params": [
        {
          "extruder": {
            "temperature": 205.2,
            "target": 210.0,
            "power": 0.8
          },
          "heater_bed": {
            "temperature": 58.9,
            "target": 60.0,
            "power": 0.25
          }
        },
        1634567890.123
      ]
    }
  },
  "query_format": {
    "description": "How to query specific objects via REST API",
    "example_url": "/printer/objects/query?extruder&heater_bed&print_stats&toolhead",
    "example_response": {
      "result": {
        "status": {
          "extruder": {
            "temperature": 205.2,
            "target": 210.0,
            "power": 0.8,
            "can_extrude": true
          },
          "heater_bed": {
            "temperature": 58.9,
            "target": 60.0,
            "power": 0.25
          },
          "print_stats": {
            "filename": "test_print.gcode",
            "state": "printing",
            "print_duration": 1234.56,
            "progress": 0.45
          },
          "toolhead": {
            "position": [135.0, 135.0, 25.5, 150.2],
            "homed_axes": "xyz"
          }
        }
      }
    }
  }
}